# ====== LOCAL DEVELOPMENT ONLY (NOT FOR DEPLOYMENT) ======

# Option A: Direct Gemini API key (for local dev only - NEVER commit this)
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: Use Secret Manager (for production / Cloud Run)
# GEMINI_SECRET_NAME=projects/YOUR_PROJECT_ID/secrets/gemini-api-key/versions/latest

# Option A: Base64-encoded Firebase Service Account JSON (for local dev)
# Generate with: cat service-account.json | base64 -w 0
FIREBASE_SERVICE_ACCOUNT_KEY=your_base64_service_account_here

# Port (Cloud Run sets this automatically)
PORT=8080
